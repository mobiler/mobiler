<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and older (Android 12+ reads data_extraction_rules.xml).
   mobiler_secure.xml (the securestore plugin) is excluded: its values are encrypted with a key
   in this device's Android Keystore, which a backup never carries, so a restored copy could not
   be read. Everything else backs up, including cx.save's state (mobiler.xml); that is plaintext,
   so keep secrets in securestore. See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="mobiler_secure.xml"/>
</full-backup-content>
