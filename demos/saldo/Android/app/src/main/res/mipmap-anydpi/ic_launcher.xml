<?xml version="1.0" encoding="utf-8"?>
<!-- Saldo's own icon: its foreground is a PNG (saldo_launcher_foreground), so the template's vector
     foreground and monochrome layer are not used. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/saldo_launcher_foreground" />
</adaptive-icon>
